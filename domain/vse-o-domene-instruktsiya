<script>
  // REVEAL
  const obs = new IntersectionObserver(e => { e.forEach(el => { if (el.isIntersecting) el.target.classList.add('visible') }) }, { threshold: .07 });
  document.querySelectorAll('.reveal').forEach(el => obs.observe(el));

  // FAQ
  document.querySelectorAll('.faq-s').forEach(s => {
    s.addEventListener('click', () => {
      const was = s.classList.contains('open');
      document.querySelectorAll('.faq-s').forEach(x => x.classList.remove('open'));
      if (!was) s.classList.add('open');
    });
  });

  // COOKIE
  function getCookieConsent() { return localStorage.getItem('cookie_consent') === 'true'; }
  function setCookieConsent() { localStorage.setItem('cookie_consent', 'true'); localStorage.setItem('cookie_consent_date', Date.now()); }
  (function () {
    if (!getCookieConsent()) {
      setTimeout(() => document.getElementById('cookieBanner').classList.add('show'), 800);
    }
  })();
  window.acceptCookies = function () {
    setCookieConsent();
    const b = document.getElementById('cookieBanner');
    b.style.transform = 'translateX(-50%) translateY(120px)';
    b.style.opacity = '0';
    setTimeout(() => b.remove(), 400);
  };
</script>
